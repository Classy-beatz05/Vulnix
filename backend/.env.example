# Copy to .env and edit before running in anything beyond local dev.

# Postgres in prod, e.g. postgresql+psycopg2://user:pass@host:5432/vulnix
DATABASE_URL=sqlite:///./vulnix.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=8f4a9c2d7e1b6a5f3c9d8e2a7b4f1c6d9e3a5b7c
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Comma-separated list of origins allowed to call the API.
# Auth is bearer-token based (no cookies), so "*" is safe for local dev.
# Tighten to your real frontend origin(s) before deploying.
CORS_ORIGINS=*

# Requests per minute per client (IP or user)
RATE_LIMIT_PER_MINUTE=60

# Upload limits
MAX_ZIP_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=200
MAX_ZIP_FILE_COUNT=5000

# Per-request timeout for outbound assessment checks (seconds)
CHECK_TIMEOUT_SECONDS=8
